# ─────────────────────────────────────────────
# ShopBoss Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# ── Telegram ─────────────────────────────────
# From @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Your bot's username WITHOUT the @ (e.g. shopboss_bot)
# Used in payment success pages
BOT_USERNAME=your_shopboss_bot

# Your personal Telegram ID — get it from @userinfobot
# Only this ID can use /admin /licenses /activate /revenue
ADMIN_TELEGRAM_ID=your_telegram_id_here

# ── Deployment ───────────────────────────────
# Your Railway/Render URL — no trailing slash
WEBHOOK_URL=https://your-shopboss.up.railway.app

# Auto-set by Railway/Render
PORT=3000

# ── Flutterwave ──────────────────────────────
# From dashboard.flutterwave.com → Settings → API Keys
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx-X

# Webhook hash — set this in Flutterwave dashboard → Webhooks
# Use any random string, e.g: openssl rand -hex 32
FLW_WEBHOOK_HASH=your_random_webhook_secret_here

# ── AI Features ──────────────────────────────
# From console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── Optional ─────────────────────────────────
# Redis URL for persistent sessions (Railway Redis add-on)
# REDIS_URL=redis://default:password@host:6379
