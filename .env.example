# ─────────────────────────────────────────────
# ShopBoss Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# Required: From @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Required for production: Your Railway/Render URL
# Leave blank for local dev (uses long polling)
WEBHOOK_URL=https://your-shopboss.railway.app

# Required for AI features: From console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Redis URL for persistent sessions
# Get from Railway/Render Redis add-on
# REDIS_URL=redis://default:password@host:6379

# Auto-set by Railway/Render
PORT=3000
